-Global Instance type_eq_dec : EqDecision type.
-Proof. Admitted.
+Fixpoint type_dec (x y : type) {struct x} : {x = y} + {x <> y}
+with field_dec (x y : field_decl) {struct x} : {x = y} + {x <> y}
+with sig_dec (x y : signature) {struct x} : {x = y} + {x <> y}
+with elem_dec (x y : interface_elem) {struct x} : {x = y} + {x <> y}
+with term_dec (x y : type_term) {struct x} : {x = y} + {x <> y}.
+Proof.
+  all: decide equality; try apply type_dec; try apply field_dec;
+    try apply sig_dec; try apply elem_dec; try apply term_dec;
+    try apply list_eq_dec; try apply type_dec; try apply field_dec;
+    try apply elem_dec; try apply term_dec; try apply decide;
+    try decide equality.
+  all: try (intros; apply Integers.w8_eq_dec).
+  all: try apply Z.eq_dec; try apply Bool.bool_dec.
+  unfold Decision. decide equality.
+Defined.
+
+Global Instance signature_eq_dec : EqDecision signature := sig_dec.
+Global Instance type_eq_dec : EqDecision type := type_dec.
 
 Global Instance type_countable : Countable type.
