--- a/goose/goose.go
+++ b/goose/goose.go
@@ -1460,9 +1460,22 @@ func (ctx *Ctx) exprAddr(e ast.Expr) glang.Expr {
 		}
 	case *ast.IndexExpr:
 		targetTy := ctx.typeOf(e.X)
+		var target glang.Expr
+		switch ty := targetTy.Underlying().(type) {
+		case *types.Array:
+			target = ctx.exprAddr(e.X)
+		case *types.Pointer:
+			if _, ok := ty.Elem().Underlying().(*types.Array); !ok {
+				ctx.unsupported(e, "indexing pointer to non-array")
+			}
+			targetTy = ty.Elem()
+			target = ctx.expr(e.X)
+		default:
+			target = ctx.expr(e.X)
+		}
 		return glang.NewCallExpr(glang.VerbatimExpr("IndexRef"),
 			ctx.glangType(e, targetTy),
-			glang.TupleExpr{ctx.expr(e.X),
+			glang.TupleExpr{target,
 				ctx.exprIntoType(e.Index, ctx.getIndexType(e.Index, targetTy))})
 	case *ast.StarExpr:
 		return ctx.expr(e.X)
