+Lemma wp_alloc_array s E vs :
+  vs ≠ [] →
+  {{{ True }}} AllocArray (Val (ArrayV vs)) @ s; E
+  {{{ l, RET #l; ⌜ l ≠ null ∧ addr_offset l = 0%Z ⌝ ∗
+      na_block_size l (length vs) ∗ pointsto_vals_toks l (DfracOwn 1) vs }}}.
+Proof.
+  intros Hnonempty. destruct vs as [|v vs]; first done.
+  iIntros (Φ) "_ HΦ". iApply wp_lift_atomic_base_step_no_fork; auto.
+  iIntros (σ1 g1 ns mj D κ κs k) "[Hσ ?] Hg !>"; iSplit.
+  { iPureIntro. do 8 eexists.
+    { apply fresh_locs_isFresh. }
+    all: repeat eexists. }
+  iNext; iIntros (v2 σ2 g2 efs Hstep); inv_base_step.
+  iMod (na_heap_alloc_list tls (heap σ1) l (v :: vs) (Reading O) with "Hσ")
+    as "(Hσ & Hblock & Hl)".
+  { simpl. lia. }
+  { destruct H as (?&?). eauto. }
+  { destruct H as (Hfresh&?). eapply Hfresh. }
+  { destruct H as (Hfresh&?). destruct (Hfresh 0) as (?&Hfresh0).
+    by rewrite loc_add_0 in Hfresh0. }
+  { eauto. }
+  iMod (global_state_interp_le _ _ _ _ _ κs with "[$]") as "$".
+  { rewrite /step_count_next/=. lia. }
+  iModIntro; iSplit; first done. unfold state_init_heap_array. simpl.
+  rewrite /RecordSet.set /=. iFrame.
+  iApply "HΦ". iFrame "Hblock". iSplit.
+  { iPureIntro. split; eauto using isFresh_not_null. destruct H; naive_solver. }
+  rewrite /pointsto_vals_toks.
+  iApply (big_sepL_mono
+    (λ i w, na_heap_pointsto (l +ₗ i) (DfracOwn 1) w ∗ meta_token (l +ₗ i) ⊤)%I
+    (λ i w, (l +ₗ i) ↦ w ∗ meta_token (l +ₗ i) ⊤)%I
+    (v :: vs) with "Hl").
+  iIntros (i w Hi) "[Hw Hmeta]".
+  iFrame "Hmeta". iApply (na_pointsto_to_heap with "Hw").
+  destruct H as (Hfresh&_). apply Hfresh.
+Qed.
