theorem column_cases (column : Fin 6) : column=0 ∨ column=1 ∨ column=2 ∨ column=3 ∨ column=4 ∨ column=5 := by
  have bound := column.isLt
  simp only [Fin.ext_iff]
  omega
set_option pp.all true in
#check @ShielddSecurity.TransferPoseidonCall04R04Proof.column_cases
#print axioms ShielddSecurity.TransferPoseidonCall04R04Proof.column_cases
theorem round_checked : checkRound p copy originalRows parameters 4 before shifted transformed after fifthHints=true := by
  simp only [checkRound,Bool.and_eq_true]
  constructor
  · apply List.all_eq_true.mpr
    intro column _
    rcases column_cases column with rfl|rfl|rfl|rfl|rfl|rfl
    · exact column0_checked
    · exact column1_checked
    · exact column2_checked
    · exact column3_checked
    · exact column4_checked
    · exact column5_checked
  · apply List.all_eq_true.mpr
    intro column _
    simp only [decide_eq_true_eq]
    rcases column_cases column with rfl|rfl|rfl|rfl|rfl|rfl
    · exact mix0_checked
    · exact mix1_checked
    · exact mix2_checked
    · exact mix3_checked
    · exact mix4_checked
    · exact mix5_checked

set_option pp.all true in
#check @ShielddSecurity.TransferPoseidonCall04R04Proof.round_checked
#print axioms ShielddSecurity.TransferPoseidonCall04R04Proof.round_checked
theorem round_certificate : RoundCertificate p (unoutlineRows copy originalRows.toList) parameters 4 before shifted transformed after :=
  checkRound_sound p copy originalRows parameters 4 before shifted transformed after fifthHints round_checked
set_option pp.all true in
#check @ShielddSecurity.TransferPoseidonCall04R04Proof.round_certificate
#print axioms ShielddSecurity.TransferPoseidonCall04R04Proof.round_certificate
theorem reverse_checked : checkOriginalCoverage p copy arithmeticRows emittedArith rowMapping=true := by
  simp only [checkOriginalCoverage,Bool.and_eq_true]
  constructor
  · decide +kernel
  · apply List.all_eq_true.mpr
    intro index member
    have bound := List.mem_range.mp member
    rw [rows_shape.1] at bound
    have cases : index=0 ∨ index=1 ∨ index=2 ∨ index=3 := by omega
    rcases cases with rfl|rfl|rfl|rfl
    · exact row0_checked
    · exact row1_checked
    · exact row2_checked
    · exact row3_checked

set_option pp.all true in
#check @ShielddSecurity.TransferPoseidonCall04R04Proof.reverse_checked
#print axioms ShielddSecurity.TransferPoseidonCall04R04Proof.reverse_checked
theorem reverse_coverage : ∀ actual∈arithmeticRows.toList,∃ expected∈emitted materializedSteps,canonical p (unoutline copy actual.a)=canonical p expected.a ∧ canonical p (unoutline copy actual.b)=canonical p expected.b := by
  simpa [emittedArith] using checkOriginalCoverage_sound p copy arithmeticRows emittedArith rowMapping reverse_checked
set_option pp.all true in
#check @ShielddSecurity.TransferPoseidonCall04R04Proof.reverse_coverage
#print axioms ShielddSecurity.TransferPoseidonCall04R04Proof.reverse_coverage
theorem ordered : Topological [0,copy] [] materializedSteps := CompilerOrder.checked_order _ _ _ ordered_checked
set_option pp.all true in
#check @ShielddSecurity.TransferPoseidonCall04R04Proof.ordered
#print axioms ShielddSecurity.TransferPoseidonCall04R04Proof.ordered
theorem write_bounds (column : Nat) (member : column∈PoseidonCompletion.writes materializedSteps) : 23148≤column ∧ column≤23151 :=
  of_decide_eq_true (List.all_eq_true.mp writes_checked column member)
set_option pp.all true in
#check @ShielddSecurity.TransferPoseidonCall04R04Proof.write_bounds
#print axioms ShielddSecurity.TransferPoseidonCall04R04Proof.write_bounds
theorem emitted_support (row : Row) (member : row∈emitted materializedSteps) (term : Nat × Int) (present : term∈row.a++row.b) : term.1<23152 :=
  of_decide_eq_true (List.all_eq_true.mp (List.all_eq_true.mp emitted_support_checked row member) term present)
set_option pp.all true in
#check @ShielddSecurity.TransferPoseidonCall04R04Proof.emitted_support
#print axioms ShielddSecurity.TransferPoseidonCall04R04Proof.emitted_support
variable {F : Type} [Field F] [CharP F p]
theorem legal (base : Nat → F) : Legal base materializedSteps := by
  simp [materializedSteps,Legal,Step.Legal]
set_option pp.all true in
#check @ShielddSecurity.TransferPoseidonCall04R04Proof.legal
#print axioms ShielddSecurity.TransferPoseidonCall04R04Proof.legal
theorem arbitrary_round_sound (rho : Nat → F) (one : rho 0=1) (four : (4:F)≠0) (satisfied : Satisfies rho originalRows.toList) :
    (fun column => eval rho (after column))=Poseidon.round (castParameters parameters) 4 (fun column => eval rho (before column)) := by
  have unoutlined := unoutline_rows_sound rho copy originalRows.toList satisfied (checkRowAt_sound p originalRows 4 _ copy_checked)
  exact round_certificate_sound rho (unoutlineRows copy originalRows.toList) parameters 4 before shifted transformed after one four unoutlined round_certificate
set_option pp.all true in
#check @ShielddSecurity.TransferPoseidonCall04R04Proof.arbitrary_round_sound
#print axioms ShielddSecurity.TransferPoseidonCall04R04Proof.arbitrary_round_sound
end ShielddSecurity.TransferPoseidonCall04R04Proof
