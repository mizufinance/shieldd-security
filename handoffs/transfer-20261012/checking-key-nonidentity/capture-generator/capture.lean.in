import ShielddSecurity.MapArithmeticAdapter704
import ShielddSecurity.CheckingBase598
set_option autoImplicit false
set_option maxHeartbeats 900000
set_option maxRecDepth 8192
noncomputable section
namespace ShielddSecurity.@@NAME@@
open Compiler CompilerArithmeticTransport41 CompilerAssertionBlock51 ConcreteJubjubField01 MapArithmeticAdapter704
@@DEFINITIONS@@
theorem checked : check entry=true := by decide +kernel

theorem equation (rho : Nat → F) (arithmetic : SatisfiesAt rho CapturedFullArithmetic52.rowAt 177954) :
    rho @@OUTPUT@@=rho @@HINT@@*eval rho CheckingBase598.baseX := by
  have result := MapArithmeticAdapter704.equation entry checked rho arithmetic
  simpa only [entry,CheckingBase598.baseX,eval,Int.cast_one,one_mul,add_zero,Bool.false_eq_true,if_false] using result

theorem captured : CompilerRowSlice63.check CapturedFullRelation58.rowAt (177954+@@POSITION@@) 1 assertionRows=true := by decide +kernel

theorem rows (rho : Nat → F) (one : rho copy=1) (inverse : rho @@OUTPUT@@=1) :
    SatisfiesAt rho (fun i => CapturedFullRelation58.rowAt (177954+@@POSITION@@+i)) 1 := by
  apply (CompilerRowSlice63.selected_satisfies_iff CapturedFullRelation58.rowAt (177954+@@POSITION@@) 1 assertionRows captured rho).mp
  intro row member
  simp only [assertionRows,List.mem_cons,List.not_mem_nil,or_false] at member
  subst row
  change eval rho [(@@OUTPUT@@,(p:Int)-1),(copy,1)]*eval rho [(@@OUTPUT@@,(p:Int)-1),(copy,1)]=eval rho []
  have shape : canonical p [(@@OUTPUT@@,(p:Int)-1),(copy,1)]=canonical p [(@@OUTPUT@@,-1),(copy,1)] := by decide +kernel
  rw [canonical_equal rho _ _ shape]
  simp only [eval,Int.cast_neg,Int.cast_one,one_mul,neg_mul,one,inverse,add_zero,neg_add_cancel,mul_zero,zero_mul]
end ShielddSecurity.@@NAME@@

set_option pp.all true in
#check @ShielddSecurity.@@NAME@@.checked
#print axioms ShielddSecurity.@@NAME@@.checked

set_option pp.all true in
#check @ShielddSecurity.@@NAME@@.equation
#print axioms ShielddSecurity.@@NAME@@.equation

set_option pp.all true in
#check @ShielddSecurity.@@NAME@@.captured
#print axioms ShielddSecurity.@@NAME@@.captured

set_option pp.all true in
#check @ShielddSecurity.@@NAME@@.rows
#print axioms ShielddSecurity.@@NAME@@.rows
