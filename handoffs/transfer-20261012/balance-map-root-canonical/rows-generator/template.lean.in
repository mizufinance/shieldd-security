import ShielddSecurity.ScalarCanonicalNumeric388
import ShielddSecurity.CapturedRegistryValueRange97
set_option autoImplicit false
set_option maxHeartbeats 900000
set_option maxRecDepth 8192
noncomputable section
namespace ShielddSecurity.IvkCanonicalRows389
open Compiler CompilerArithmeticTransport41 CompilerAssertionBlock51
def valueLC : Linear := [(0,1),(2251,(p:Int)-1),(50706,1)]
def expected (index : Nat) : Recipe :=
    if index=0 then .square valueLC valueLC else .linear [(0,1)] valueLC
noncomputable def block : Block p copy 2 where
    actual := fun index => CapturedAssertions50B0008.block.actual (203+index)
    recipe := fun index => CapturedAssertions50B0008.block.recipe (203+index)
    exact_checked := by
      intro index bound
      exact CapturedAssertions50B0008.block.exact_checked (203+index) (by omega)
theorem hint_exact (index : Nat) (bound : index<2) : block.recipe index=some (true,expected index) := by
    have cases : index=0 ∨ index=1 := by omega
    rcases cases with rfl|rfl <;> rfl
theorem full_position_checked : (List.range 2).all (fun index => decide
    (CapturedFullRelation58.rowAt (180205+index)=block.actual index)) = true := by decide +kernel

theorem full_position (index : Nat) (bound : index<2) :
    CapturedFullRelation58.rowAt (180205+index)=block.actual index :=
  of_decide_eq_true (List.all_eq_true.mp full_position_checked index (List.mem_range.mpr bound))
variable {F : Type} [Field F] [CharP F p]
theorem value_one (rho : Nat → F) (n : Nat) (bound : n<p) (zero : rho 0=1) (one : rho copy=1)
    (arithmetic : SatisfiesAt rho CapturedFullArithmetic52.rowAt 177954)
    (bits : ∀ index<255,rho (2000+index)=BinaryComparison100.bit (F:=F) (ScalarCanonicalNumeric388.bitAt n (2000+index))) :
    eval rho valueLC=1 := by
  have numeric:=ScalarCanonicalNumeric388.semantic rho n bound one arithmetic bits
  have normalization : canonical p valueLC=canonical p [(0,1),(2251,-1),(50706,1)] := by decide +kernel
  have normalized:=canonical_equal rho valueLC [(0,1),(2251,-1),(50706,1)] normalization
  rw [normalized]
  simpa only [eval,Int.cast_one,Int.cast_neg,one_mul,neg_mul,add_zero,zero,sub_eq_add_neg,add_assoc] using numeric
theorem truth (rho : Nat → F) (n : Nat) (bound : n<p) (zero : rho 0=1) (one : rho copy=1)
    (arithmetic : SatisfiesAt rho CapturedFullArithmetic52.rowAt 177954)
    (bits : ∀ index<255,rho (2000+index)=BinaryComparison100.bit (F:=F) (ScalarCanonicalNumeric388.bitAt n (2000+index))) :
    TruthAt rho block.recipe 2 := by
  have value:=value_one rho n bound zero one arithmetic bits
  intro index before hint found
  have same : hint=(true,expected index) := Option.some.inj (found.symm.trans (hint_exact index before))
  subst hint
  have cases : index=0 ∨ index=1 := by omega
  rcases cases with rfl|rfl
  · change eval rho valueLC*eval rho valueLC=eval rho valueLC
    rw [value]
    ring
  · change eval rho [(0,1)]=eval rho valueLC
    simp only [eval,Int.cast_one,one_mul,add_zero,zero,value]
theorem complete (rho : Nat → F) (n : Nat) (bound : n<p) (zero : rho 0=1) (one : rho copy=1)
    (arithmetic : SatisfiesAt rho CapturedFullArithmetic52.rowAt 177954)
    (bits : ∀ index<255,rho (2000+index)=BinaryComparison100.bit (F:=F) (ScalarCanonicalNumeric388.bitAt n (2000+index))) :
    SatisfiesAt rho (fun index => CapturedFullRelation58.rowAt (180205+index)) 2 := by
  have localRows:=(satisfies_iff copy 2 block rho (one.trans zero.symm)).mpr (truth rho n bound zero one arithmetic bits)
  intro index before row found
  change CapturedFullRelation58.rowAt (180205+index)=some row at found
  rw [full_position index before] at found
  exact localRows index before row found
end ShielddSecurity.IvkCanonicalRows389

set_option pp.all true in
#check @ShielddSecurity.IvkCanonicalRows389.valueLC
#print axioms ShielddSecurity.IvkCanonicalRows389.valueLC
set_option pp.all true in
#check @ShielddSecurity.IvkCanonicalRows389.expected
#print axioms ShielddSecurity.IvkCanonicalRows389.expected
set_option pp.all true in
#check @ShielddSecurity.IvkCanonicalRows389.block
#print axioms ShielddSecurity.IvkCanonicalRows389.block
set_option pp.all true in
#check @ShielddSecurity.IvkCanonicalRows389.hint_exact
#print axioms ShielddSecurity.IvkCanonicalRows389.hint_exact
set_option pp.all true in
#check @ShielddSecurity.IvkCanonicalRows389.full_position_checked
#print axioms ShielddSecurity.IvkCanonicalRows389.full_position_checked

set_option pp.all true in
#check @ShielddSecurity.IvkCanonicalRows389.full_position
#print axioms ShielddSecurity.IvkCanonicalRows389.full_position
set_option pp.all true in
#check @ShielddSecurity.IvkCanonicalRows389.value_one
#print axioms ShielddSecurity.IvkCanonicalRows389.value_one
set_option pp.all true in
#check @ShielddSecurity.IvkCanonicalRows389.truth
#print axioms ShielddSecurity.IvkCanonicalRows389.truth
set_option pp.all true in
#check @ShielddSecurity.IvkCanonicalRows389.complete
#print axioms ShielddSecurity.IvkCanonicalRows389.complete
