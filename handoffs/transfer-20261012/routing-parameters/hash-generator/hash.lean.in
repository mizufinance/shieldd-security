import ShielddSecurity.RoutingParameterHashPermutation877
import ShielddSecurity.RoutingParameterHashCapture873
set_option autoImplicit false
set_option maxHeartbeats 900000
set_option maxRecDepth 8192
noncomputable section
namespace ShielddSecurity.RoutingParameterHash878
open Compiler CompilerAssertionBlock51
open CapturedInitial73419Generic01 (p copy)
noncomputable def parameters := RoutingParameterHashPermutation877.parameters
noncomputable def result := RoutingParameterHashPermutation877.result
variable {F : Type} [Field F] [CharP F p]
attribute [local irreducible] SatisfiesAt

theorem initial (rho : Nat → F) (one : rho 0=1) :
    (fun i => eval rho (RoutingParameterHashPermutation877.before i))=
      Poseidon.absorb (Poseidon.initial 33 3) [rho 19455,rho 19456,rho 19590] := by
  funext i
  have cases : i=0 ∨ i=1 ∨ i=2 ∨ i=3 ∨ i=4 ∨ i=5 := by have h:=i.isLt;simp only [Fin.ext_iff];omega
  rcases cases with rfl|rfl|rfl|rfl|rfl|rfl <;>
    simp [RoutingParameterHashPermutation877.before,RoutingParameterHashCapture873C180B0R00.before,
      Poseidon.absorb,Poseidon.initial,eval,one,Fin.val_ofNat]
  · change eval rho [(19590,1)]=rho 19590
    simp [eval]
  · change (0:F)=0
    rfl
  · change (0:F)=0
    rfl

theorem hash (rho : Nat → F) (one : rho 0=1) (linked : rho copy=rho 0)
    (arithmetic : SatisfiesAt rho CapturedFullArithmetic52.rowAt 177954) :
    eval rho result=Poseidon.hash6 (Poseidon.castParameters parameters) 33 [rho 19455,rho 19456,rho 19590] := by
  have permutation := RoutingParameterHashPermutation877.permutation rho one linked arithmetic
  rw [initial rho one] at permutation
  have joined := Poseidon.hash6_of_one_block (Poseidon.castParameters parameters) 33 [rho 19455,rho 19456,rho 19590]
    (Poseidon.initial 33 3) (fun i => eval rho (RoutingParameterHashPermutation877.after i)) rfl rfl permutation
  simpa only [RoutingParameterHashPermutation877.result_port,result] using joined
end ShielddSecurity.RoutingParameterHash878

set_option pp.all true in
#check @ShielddSecurity.RoutingParameterHash878.initial
#print axioms ShielddSecurity.RoutingParameterHash878.initial

set_option pp.all true in
#check @ShielddSecurity.RoutingParameterHash878.hash
#print axioms ShielddSecurity.RoutingParameterHash878.hash
