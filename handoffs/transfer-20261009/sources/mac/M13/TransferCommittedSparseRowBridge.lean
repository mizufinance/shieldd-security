def reconstructionTemplate : List (Nat × Int) :=
  (9,-1) :: (List.range 252).map (fun bit => (22232+bit,(2:Int)^bit))
theorem coefficients_exact : reconstructionTerms = reconstructionTemplate := by decide
variable {F : Type} [Field F]
def dot : List (Nat × Int) → (Nat → F) → F
  | [], _ => 0
  | (index,coefficient)::tail, z => (coefficient:F)*z index + dot tail z
def weighted (z : Nat → F) : F :=
  dot ((List.range 252).map (fun bit => (22232+bit,(2:Int)^bit))) z
def LinkRow (z : Nat → F) : Prop := (dot [(2,1),(9,-1)] z)^2 = dot [] z
def ReconstructionRow (z : Nat → F) : Prop := (dot reconstructionTerms z)^2 = dot [] z

theorem committed_shadow_eq (z : Nat → F) (row : LinkRow z) : z 2 = z 9 := by
  have square : (z 2-z 9)^2=0 := by simpa [LinkRow,dot,sub_eq_add_neg] using row
  exact sub_eq_zero.mp (mul_self_eq_zero.mp (by simpa only [pow_two] using square))

theorem shadow_reconstruction (z : Nat → F) (row : ReconstructionRow z) : z 9 = weighted z := by
  have square : (-z 9+weighted z)^2=0 := by
    simpa [ReconstructionRow,coefficients_exact,reconstructionTemplate,dot,weighted] using row
  have zero := mul_self_eq_zero.mp (by simpa only [pow_two] using square)
  have sub : weighted z-z 9=0 := by simpa only [sub_eq_add_neg,add_comm] using zero
  exact (sub_eq_zero.mp sub).symm

theorem committed_reconstruction (z : Nat → F) (link : LinkRow z)
    (reconstruction : ReconstructionRow z) : z 2 = weighted z :=
  (committed_shadow_eq z link).trans (shadow_reconstruction z reconstruction)

def fieldModulus : Nat := 52435875175126190479447740508185965837690552500527637822603658699938581184513

theorem canonical_negative_one [CharP F fieldModulus] :
    ((fieldModulus-1:Nat):F) = -1 := by
  rw [Nat.cast_sub (by decide : 1 ≤ fieldModulus), CharP.cast_eq_zero F fieldModulus]
  simp

theorem raw_link_consequence [CharP F fieldModulus] (z : Nat → F)
    (row : (z 2 + ((fieldModulus-1:Nat):F)*z 9)^2=0) : z 2=z 9 := by
  apply committed_shadow_eq z
  simpa [LinkRow,dot,canonical_negative_one] using row

theorem raw_reconstruction_consequence [CharP F fieldModulus] (z : Nat → F)
    (row : (((fieldModulus-1:Nat):F)*z 9+weighted z)^2=0) : z 9=weighted z := by
  apply shadow_reconstruction z
  simpa [ReconstructionRow,coefficients_exact,reconstructionTemplate,dot,canonical_negative_one,weighted] using row

theorem raw_joined_consequence [CharP F fieldModulus] (z : Nat → F)
    (link : (z 2 + ((fieldModulus-1:Nat):F)*z 9)^2=0)
    (reconstruction : (((fieldModulus-1:Nat):F)*z 9+weighted z)^2=0) : z 2=weighted z :=
  (raw_link_consequence z link).trans (raw_reconstruction_consequence z reconstruction)

-- These two rows alone supply no bit Booleanity or subgroup-order inequality.
set_option pp.all true in
#check @coefficients_exact
#print axioms coefficients_exact
set_option pp.all true in
#check @committed_shadow_eq
#print axioms committed_shadow_eq
set_option pp.all true in
#check @shadow_reconstruction
#print axioms shadow_reconstruction
set_option pp.all true in
#check @committed_reconstruction
#print axioms committed_reconstruction
set_option pp.all true in
#check @canonical_negative_one
#print axioms canonical_negative_one
set_option pp.all true in
#check @raw_link_consequence
#print axioms raw_link_consequence
set_option pp.all true in
#check @raw_reconstruction_consequence
#print axioms raw_reconstruction_consequence
set_option pp.all true in
#check @raw_joined_consequence
#print axioms raw_joined_consequence
end ShielddSecurity.TransferCommittedSparseRowBridge
