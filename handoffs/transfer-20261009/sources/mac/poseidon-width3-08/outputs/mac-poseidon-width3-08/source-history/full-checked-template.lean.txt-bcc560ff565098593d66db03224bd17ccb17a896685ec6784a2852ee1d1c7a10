variable {F : Type} [Field F] [CharP F p]
theorem checked_permutation (rho : Nat → F) (one : rho 0=1) (four : (4:F)≠0)
    (selected : List (Fin 35)) (port : Fin 3)
    (checked : PoseidonCallTraversal03.check selected port=true)
    (satisfied : Satisfies rho originalRows) :
    (fun column => eval rho (after 64 column))=Poseidon.permute (castParameters parameters)
      (Poseidon.absorb (Poseidon.initial 24 2) (inputValues rho)) := by
  apply PoseidonCallTraversal03.checked_rounds (castParameters parameters)
    (fun index column => eval rho (before index column)) (fun index column => eval rho (after index column))
    (Poseidon.absorb (Poseidon.initial 24 2) (inputValues rho)) selected port checked (initial_binding rho one)
  · intro index bound
    exact congrArg (fun state : State Linear 3 => fun column => eval rho (state column)) (boundary index bound)
  · intro index member
    exact all_rounds_sound rho one four satisfied index.val index.isLt

theorem checked_hash3 (rho : Nat → F) (one : rho 0=1) (four : (4:F)≠0)
    (selected : List (Fin 35)) (port : Fin 3)
    (checked : PoseidonCallTraversal03.check selected port=true)
    (satisfied : Satisfies rho originalRows) :
    eval rho (after 64 port)=Poseidon.hash3 (castParameters parameters) 24 (inputValues rho) := by
  have chunks : Poseidon.chunks2 (inputValues rho)=[inputValues rho] := by rw [input_values_exact];rfl
  have length : (inputValues rho).length=2 := by rw [input_values_exact];rfl
  have result := PoseidonHash3OneBlock08.hash3_of_one_block (castParameters parameters) 24 (inputValues rho)
    (Poseidon.initial 24 2) (fun column => eval rho (after 64 column)) chunks
    (by rw [length]) (checked_permutation rho one four selected port checked satisfied)
  rw [PoseidonCallTraversal03.output_one selected port checked]
  simpa only [input_values_exact] using result

theorem checked_total (base : Nat → F) (one : base 0=1) (linked : base copy=base 0) (four : (4:F)≠0)
    (selected : List (Fin 35)) (port : Fin 3)
    (checked : PoseidonCallTraversal03.check selected port=true) :
    Satisfies (completed base) originalRows ∧
    (∀ input<22735,completed base (3+input)=base (3+input)) ∧
    (∀ column<22738,completed base column=base column) ∧
    completed base copy=base copy ∧
    eval (completed base) (after 64 port)=Poseidon.hash3 (castParameters parameters) 24 (inputValues base) := by
  have result := checked_hash3 (completed base)
    ((original_columns_preserved base 0 (by decide)).trans one) four selected port checked (completed_rows base linked)
  rw [input_values_preserved base] at result
  exact ⟨completed_rows base linked,original_inputs_preserved base,original_columns_preserved base,copy_preserved base,result⟩

