+    // MAC DIAGNOSTIC ONLY: disposable independent replay adapter.
+    // Returns immutable assignment/layout metadata without changing the compiler.
+    pub fn mac_diagnostic_values(&self, witness: &super::Witness)
+        -> (Vec<Scalar>, usize, [u8; 32], usize, usize) {
+        let assignment = witness.assignment();
+        let auxiliary = self.rows.iter().flat_map(|row|
+            row.squared.iter().chain(row.linear.iter())).map(|(index, _)| *index as usize)
+            .find(|index| *index > self.public_inputs &&
+                !(*index >= self.committed_start &&
+                  *index < self.committed_start + self.committed_inputs()))
+            .expect("a constrained auxiliary column");
+        (assignment.values.clone(), self.committed_start,
+            assignment.relation_digest, self.rows.len(), auxiliary)
+    }
+
+    // MAC BOUNDARY DIAGNOSTIC: exact incidence and failing row identifiers.
+    pub fn mac_diagnostic_column_rows(&self, witness: &super::Witness, index: usize,
+        delta: &Scalar) -> (String, Vec<usize>, Vec<usize>) {
+        let mut values = witness.assignment().values.clone();
+        values[index] += delta;
+        let source = match &self.value_sources[index] {
+            ValueSource::One => "One".to_string(),
+            ValueSource::Circuit(idx) => format!("Circuit({idx:?})"),
+            ValueSource::DifferenceSquare(left, right) => format!("DifferenceSquare({left:?},{right:?})"),
+            ValueSource::Zero => "Zero".to_string(),
+        };
+        let mut touched = Vec::new();
+        let mut failing = Vec::new();
+        for (number, row) in self.rows.iter().enumerate() {
+            if row.squared.iter().chain(row.linear.iter()).any(|(column, _)| *column as usize == index) {
+                touched.push(number);
+            }
+            let a = dot(&row.squared, &values);
+            let b = dot(&row.linear, &values);
+            if a.clone() * &a != b { failing.push(number); }
+        }
+        (source, touched, failing)
+    }
+
+    // The original row evaluator is called unchanged. Mutations affect only a
+    // fresh private assignment clone; the witness/relation/layout stay immutable.
+    pub fn mac_diagnostic_replay(&self, witness: &super::Witness,
+        delta: Option<(usize, Scalar)>, zero_all: bool, wrong_digest: bool) -> bool {
+        let mut assignment = witness.assignment().clone();
+        if let Some((index, value)) = delta { assignment.values[index] += &value; }
+        if zero_all { assignment.values.fill(Scalar::zero()); }
+        if wrong_digest { assignment.relation_digest[0] ^= 1; }
+        self.is_satisfied(&assignment)
+    }
