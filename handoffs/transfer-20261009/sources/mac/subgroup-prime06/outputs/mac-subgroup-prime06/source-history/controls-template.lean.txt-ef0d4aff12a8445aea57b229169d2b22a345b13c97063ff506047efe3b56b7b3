import ShielddSecurity.SubgroupPrimeNode37
set_option maxHeartbeats 300000
set_option maxRecDepth 4096
namespace ShielddSecurity.SubgroupPrimeControls06
open LucasCertificate

def badBase : Certificate := {SubgroupPrimeNode37.certificate with base:=1}
def changeResidue (powers : List FactorPower) : List FactorPower := match powers with
  | head::tail => {head with residue:=(head.residue+1)%SubgroupPrimeNode37.certificate.n}::tail
  | [] => []
def changeExponent (powers : List FactorPower) : List FactorPower := match powers with
  | head::tail => {head with exponent:=head.exponent+1}::tail
  | [] => []
def badResidue : Certificate := {SubgroupPrimeNode37.certificate with powers:=changeResidue SubgroupPrimeNode37.certificate.powers}
def badExponent : Certificate := {SubgroupPrimeNode37.certificate with powers:=changeExponent SubgroupPrimeNode37.certificate.powers}
def missingFactor : Certificate := {SubgroupPrimeNode37.certificate with powers:=SubgroupPrimeNode37.certificate.powers.tail}

theorem positive : SubgroupPrimeNode37.certificate.check=true := SubgroupPrimeNode37.checked
theorem base_rejected : badBase.check=false := by decide +kernel
theorem residue_mutation_ran : badResidue≠SubgroupPrimeNode37.certificate := by
  intro equal
  have values := congrArg (fun cert : Certificate => cert.powers.head?.map FactorPower.residue) equal
  have different : badResidue.powers.head?.map FactorPower.residue≠SubgroupPrimeNode37.certificate.powers.head?.map FactorPower.residue := by decide +kernel
  exact different values
theorem residue_rejected : badResidue.check=false := by decide +kernel
theorem exponent_rejected : badExponent.check=false := by decide +kernel
theorem factor_omission_rejected : missingFactor.check=false := by decide +kernel

/-- The arithmetic checker alone deliberately does not establish primality. -/
def carmichael : Certificate := ⟨561,2,[⟨560,1,2⟩]⟩
theorem carmichael_arithmetic_passes : carmichael.check=true := by decide +kernel
theorem carmichael_children_not_prime : ¬(∀ entry ∈ carmichael.powers, Nat.Prime entry.factor) := by
  intro allPrime
  have composite : ¬Nat.Prime 560 := by decide +kernel
  exact composite (allPrime ⟨560,1,2⟩ (by simp [carmichael]))
theorem carmichael_not_prime : ¬Nat.Prime 561 := by decide +kernel
end ShielddSecurity.SubgroupPrimeControls06
